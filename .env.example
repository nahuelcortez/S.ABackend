# =============================================
#   FinTech Flow – Variáveis de Ambiente
# =============================================
# NUNCA envie o arquivo .env para o Git!

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintechflow
DB_USER=postgres
DB_PASSWORD=senha_aqui

# --- JWT (Token de autenticação) ---
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=chave_jwt_super_secreta_aqui
JWT_EXPIRES_IN=7d
